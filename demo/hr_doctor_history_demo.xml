<odoo>
    <data noupdate="0">
        <!-- Візит до Хауса -->
        <record id="visit_house_1" model="hr.hospital.visit">
            <field name="patient_id" ref="patient_thirteen"/>
            <field name="doctor_id" ref="doctor_mentor_gregory_house"/>
            <field name="planned_date" eval="datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="summary">Autoimmune disorder</field>
        </record>

        <record id="demo_history_chase" model="hr.hospital.doctor.history">
            <field name="patient_id" ref="patient_thirteen"/>
