<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_hr_hospital_disease_search" model="ir.ui.view">
            <field name="name">hr.hospital.disease.search</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="parent_id"/>

                    <filter string="Diseases" name="filter_is_not_group" domain="[('is_group', '=', False)]"/>
                    <filter string="Groups" name="filter_is_group" domain="[('is_group', '=', True)]"/>

                    <searchpanel>
                        <field name="parent_id"
                               string="Hierarchy"
                               icon="fa-folder"
                               enable_counters="1"
                               hierarchize="1"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="action_hr_hospital_disease" model="ir.actions.act_window">
            <field name="name">Diseases</field>
            <field name="res_model">hr.hospital.disease</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_hospital_disease_search"/>
            <field name="context">{'search_default_filter_is_not_group': 1}</field>
        </record>

        <record id="view_hr_hospital_disease_list" model="ir.ui.view">
            <field name="name">hr.hospital.disease.list</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="parent_id" optional="show"/>
                    <field name="is_group" optional="show"/>
                    <field name="description"/>
                    <field name="parent_path" column_invisible="True"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_disease_form" model="ir.ui.view">
            <field name="name">hr.hospital.disease.form</field>
            <field name="model">hr.hospital.disease</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="is_group"/>
                            </group>
                            <group>
                                <field name="parent_id"
                                       placeholder="Select category..."
                                       options="{'no_create': True, 'no_open': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description" placeholder="Detailed information..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>