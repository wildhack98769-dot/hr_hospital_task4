<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_hospital_visit_list" model="ir.ui.view">
            <field name="name">hr.hospital.visit.list</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <list decoration-info="state == 'planned'"
                      decoration-success="state == 'done'"
                      decoration-danger="state == 'cancelled'">
                    <field name="planned_date"/>
                    <field name="actual_date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'planned'"
                           decoration-success="state == 'done'"
                           decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_visit_search" model="ir.ui.view">
            <field name="name">hr.hospital.visit.search</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <search>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                    <field name="state"/>
                    <field name="planned_date"/>
                    <filter name="current_year"
                            string="Current Year"
                            date="planned_date"
                            default_period="year"/>
                    <group>
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                        <filter name="group_by_month" string="Month" context="{'group_by': 'planned_date:month'}"/>
                    </group>
                    <searchpanel>
                        <field name="doctor_id"/>
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="view_hr_hospital_visit_form" model="ir.ui.view">
            <field name="name">hr.hospital.visit.form</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_done" string="Завершити" type="object"
                                class="oe_highlight" invisible="state != 'planned'"/>
                        <field name="state" widget="statusbar" statusbar_visible="planned,done,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_same_disease_visits"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-stethoscope"
                                    invisible="not disease_id">
                                <field name="same_disease_visit_count" widget="statinfo" string="Схожі візити"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Пацієнт та лікар">
                                <field name="patient_id"/>
                                <field name="doctor_id"/>
                                <field name="disease_id"/>
                            </group>
                            <group string="Дати візиту">
                                <field name="planned_date"/>
                                <field name="actual_date" readonly="state == 'done'"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Епікриз" name="medical_details">
                                <field name="summary" widget="html"
                                       placeholder="Опишіть симптоми, діагноз та призначене лікування..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_hospital_visit_calendar" model="ir.ui.view">
            <field name="name">hr.hospital.visit.calendar</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <calendar string="Visits" date_start="planned_date" date_stop="actual_date" color="doctor_id" mode="month">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="disease_id"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <record id="view_hr_hospital_visit_pivot" model="ir.ui.view">
            <field name="name">hr.hospital.visit.pivot</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <pivot string="Visits by Doctor and Status">
                    <field name="doctor_id" type="row"/>
                    <field name="planned_date" type="row" interval="month"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <record id="view_hr_hospital_visit_graph" model="ir.ui.view">
            <field name="name">hr.hospital.visit.graph</field>
            <field name="model">hr.hospital.visit</field>
            <field name="arch" type="xml">
                <graph string="Monthly Visits by Disease" type="bar" stacked="True">
                    <field name="planned_date" interval="month"/>
                    <field name="disease_id"/>
                </graph>
            </field>
        </record>

        <record id="action_hr_hospital_visit" model="ir.actions.act_window">
            <field name="name">Visits</field>
            <field name="res_model">hr.hospital.visit</field>
            <field name="view_mode">list,form,calendar,pivot,graph</field>
            <field name="search_view_id" ref="view_hr_hospital_visit_search"/>
            <field name="context">{'search_default_current_year': 1}</field>
        </record>
    </data>
</odoo>
