<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_hospital_doctor_history_search" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.search</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Date: Today" name="today" domain="[('change_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>

                <group>
                    <filter string="Patient" name="group_by_patient" context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor" name="group_by_doctor" context="{'group_by': 'doctor_id'}"/>
                    <filter string="Change Date" name="group_by_date" context="{'group_by': 'change_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_history_kanban" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.kanban</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="patient_id"/>
	                <field name="doctor_id"/>
	                <field name="change_date"/>
	                <templates>
	                    <t t-name="card">
	                        <div t-attf-class="oe_kanban_global_click shadow-sm border-start border-primary border-4 rounded p-3 mb-2">
	                            <div class="row">
	                                <div class="col-8">
	                                    <strong class="o_kanban_record_title text-primary">
                                        <field name="patient_id"/>
                                    </strong>
                                </div>
                                <div class="col-4 text-end">
                                    <span class="badge rounded-pill bg-light text-dark">
                                        <field name="change_date" widget="date"/>
                                    </span>
                                </div>
                            </div>
                            <div class="mt-2">
                                <i class="fa fa-user-md text-muted me-1"/>
                                <span>Doctor: </span><field name="doctor_id"/>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="fa fa-calendar-o me-1"/>
                                <span>Appointment: </span><field name="appointment_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_hospital_doctor_history_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.list</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
	            <list string="Doctor History" default_order="change_date desc" sample="1">
	                <field name="change_date" decoration-bf="1"/>
	                <field name="patient_id" widget="many2one_avatar"/>
	                <field name="doctor_id" widget="many2one_avatar"/>
	                <field name="appointment_date" optional="show"/>
	                <field name="active" widget="boolean_toggle"/>
	            </list>
	        </field>
	    </record>

    <record id="view_hr_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.history.form</field>
        <field name="model">hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form string="Doctor History Record">
                <sheet>
                    <div class="oe_title">
                        <label for="change_date" string="Log Date"/>
                        <h1><field name="change_date" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Participants">
                            <field name="patient_id" options="{'no_create': True, 'no_open': False}"/>
                            <field name="doctor_id" options="{'no_create': True, 'no_open': False}"/>
                        </group>
                        <group string="Timing and Status">
                            <field name="appointment_date"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_doctor_history" model="ir.actions.act_window">
        <field name="name">Doctor History</field>
        <field name="res_model">hr.hospital.doctor.history</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_hr_hospital_doctor_history_search"/>
        <field name="context">{'search_default_group_by_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No history records yet.
            </p>
            <p>
                History is automatically populated when doctor assignments change.
            </p>
        </field>
    </record>

</odoo>
