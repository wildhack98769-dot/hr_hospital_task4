<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_hr_hospital_doctor_category" model="ir.actions.act_window">
            <field name="name">Doctor Qualifications</field>
            <field name="res_model">hr.hospital.doctor.category</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new doctor qualification
                </p>
                <p>
                    Examples: Higher Category, First Category, PhD, etc.
                </p>
            </field>
        </record>

        <record id="view_hr_hospital_doctor_category_list" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.category.list</field>
            <field name="model">hr.hospital.doctor.category</field>
            <field name="arch" type="xml">
                <list editable="bottom" sample="1">
                    <field name="sequence" widget="handle"/>
                    <field name="name" placeholder="Category Name (e.g. Higher)"/>
                </list>
            </field>
        </record>

        <record id="view_hr_hospital_doctor_category_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.category.kanban</field>
            <field name="model">hr.hospital.doctor.category</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click shadow-sm border-0 rounded p-3">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-light p-2 me-3 text-primary">
                                        <i class="fa fa-graduation-cap fa-lg"/>
                                    </div>
                                    <strong class="o_kanban_record_title" style="font-size: 1.1em;">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_hr_hospital_doctor_category_form" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.category.form</field>
            <field name="model">hr.hospital.doctor.category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Qualification Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Professor"/>
                            </h1>
                        </div>
                        <group>
                            <field name="sequence" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>