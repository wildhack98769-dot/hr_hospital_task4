<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hr_hospital_disease_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center mb-4">Disease Statistics Report</h2>
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr class="table-active">
                                <th>Disease</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="visit">
                                <tr>
                                    <td><span t-field="visit.disease_id"/></td>
                                    <td><span t-field="visit.patient_id"/></td>
                                    <td><span t-field="visit.doctor_id"/></td>
                                    <td><span t-field="visit.planned_date"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
