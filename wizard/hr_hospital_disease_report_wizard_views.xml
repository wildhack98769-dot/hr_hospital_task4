<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_hospital_disease_report_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.report.form</field>
        <field name="model">hr.hospital.disease.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Period">
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group string="Filters">
                        <field name="doctor_ids" widget="many2many_tags" placeholder="All Doctors"/>
                        <field name="disease_ids" widget="many2many_tags" placeholder="All Diseases"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_disease_report_wizard_binding" model="ir.actions.act_window">
        <field name="name">Disease Statistics Report</field>
        <field name="res_model">hr.hospital.disease.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
